// ============================================================
// SONG
// ============================================================
class Song {
public:
    string title;
    string artist;
    string filePath;

    Song() {}

    Song(const string& t, const string& a, const string& p) {
        title = t;
        artist = a;
        filePath = p;
    }

    void display() const {
        cout << title << " - " << artist << endl;
    }
};

// ============================================================
// HELPER FUNCTIONS
// ============================================================
string toLowerCase(string text) {
    for (char& ch : text) {
        ch = static_cast<char>(tolower(static_cast<unsigned char>(ch)));
    }
    return text;
}

bool containsIgnoreCase(const string& text, const string& keyword) {
    return toLowerCase(text).find(toLowerCase(keyword)) != string::npos;
}

bool sameIgnoreCase(const string& a, const string& b) {
    return toLowerCase(a) == toLowerCase(b);
}

bool fileExists(const string& path) {
    DWORD attributes = GetFileAttributesA(path.c_str());

    return attributes != INVALID_FILE_ATTRIBUTES &&
           !(attributes & FILE_ATTRIBUTE_DIRECTORY);
}

string getExecutableFolder() {
    char buffer[MAX_PATH];

    DWORD length = GetModuleFileNameA(NULL, buffer, MAX_PATH);

    if (length == 0) {
        return ".";
    }

    string fullPath(buffer, length);
    size_t lastSlash = fullPath.find_last_of("\\/");

    if (lastSlash == string::npos) {
        return ".";
    }

    return fullPath.substr(0, lastSlash);
}

string getSaveFilePath() {
    return getExecutableFolder() + "\\playlist.txt";
}

// ============================================================
// DOUBLY LINKED LIST NODE
// ============================================================
class Node {
public:
    Song data;
    Node* prev;
    Node* next;

    Node(const Song& song) {
        data = song;
        prev = NULL;
        next = NULL;
    }
};

// ============================================================
// DOUBLY LINKED LIST - PLAYLIST
// ============================================================
class Playlist {
private:
    Node* head;
    Node* tail;

public:
    Node* current;
    int count;

    Playlist() {
        head = NULL;
        tail = NULL;
        current = NULL;
        count = 0;
    }

    ~Playlist() {
        clear();
    }

    Node* addSong(const Song& song) {
        Node* newNode = new Node(song);

        if (head == NULL) {
            head = tail = newNode;
            current = head;
        }
        else {
            newNode->prev = tail;
            tail->next = newNode;
            tail = newNode;
        }

        count++;
        return newNode;
    }

    bool deleteSong(const string& title) {
        Node* temp = head;

        while (temp != NULL) {
            if (sameIgnoreCase(temp->data.title, title)) {

                // Update previous node
                if (temp->prev != NULL) {
                    temp->prev->next = temp->next;
                }
                else {
                    head = temp->next;
                }

                // Update next node
                if (temp->next != NULL) {
                    temp->next->prev = temp->prev;
                }
                else {
                    tail = temp->prev;
                }

                // Update current song
                if (current == temp) {
                    if (temp->next != NULL) {
                        current = temp->next;
                    }
                    else if (temp->prev != NULL) {
                        current = temp->prev;
                    }
                    else {
                        current = NULL;
                    }
                }

                delete temp;
                count--;

                if (count == 0) {
                    head = tail = current = NULL;
                }

                return true;
            }

            temp = temp->next;
        }

        return false;
    }

    Node* searchSong(const string& keyword) {
        Node* temp = head;

        while (temp != NULL) {
            if (containsIgnoreCase(temp->data.title, keyword) ||
                containsIgnoreCase(temp->data.artist, keyword)) {
                return temp;
            }

            temp = temp->next;
        }

        return NULL;
    }

    Node* getNodeByNumber(int number) {
        if (number < 1 || number > count) {
            return NULL;
        }

        Node* temp = head;
        int position = 1;

        while (temp != NULL) {
            if (position == number) {
                return temp;
            }

            temp = temp->next;
            position++;
        }

        return NULL;
    }

    void display() const {
        if (head == NULL) {
            cout << "\nPlaylist is empty.\n";
            return;
        }

        cout << "\n";
        cout << "=====================================================\n";
        cout << "                    PLAYLIST\n";
        cout << "=====================================================\n";

        Node* temp = head;
        int number = 1;

        while (temp != NULL) {
            cout << number << ". ";

            if (temp == current) {
                cout << "[NOW PLAYING] ";
            }

            temp->data.display();

            temp = temp->next;
            number++;
        }

        cout << "=====================================================\n";
        cout << "Total songs: " << count << "\n";
    }

    void sortByTitle() {
        if (head == NULL || head->next == NULL) {
            return;
        }

        // Bubble Sort
        bool swapped;

        do {
            swapped = false;
            Node* temp = head;

            while (temp != NULL && temp->next != NULL) {

                if (toLowerCase(temp->data.title) >
                    toLowerCase(temp->next->data.title)) {

                    Song temporary = temp->data;
                    temp->data = temp->next->data;
                    temp->next->data = temporary;

                    swapped = true;
                }

                temp = temp->next;
            }

        } while (swapped);
    }

    Node* getHead() const {
        return head;
    }

    void clear() {
        Node* temp = head;

        while (temp != NULL) {
            Node* nextNode = temp->next;
            delete temp;
            temp = nextNode;
        }

        head = NULL;
        tail = NULL;
        current = NULL;
        count = 0;
    }
};

// ============================================================
// QUEUE - FIFO
// Implemented using a singly linked queue
// ============================================================
class QueueNode {
public:
    Song data;
    QueueNode* next;

    QueueNode(const Song& song) {
        data = song;
        next = NULL;
    }
};

class SongQueue {
private:
    QueueNode* front;
    QueueNode* rear;

public:
    int count;

    SongQueue() {
        front = NULL;
        rear = NULL;
        count = 0;
    }

    ~SongQueue() {
        clear();
    }

    void enqueue(const Song& song) {
        QueueNode* newNode = new QueueNode(song);

        if (rear == NULL) {
            front = rear = newNode;
        }
        else {
            rear->next = newNode;
            rear = newNode;
        }

        count++;
    }

    bool isEmpty() const {
        return front == NULL;
    }

    Song* peek() {
        if (front == NULL) {
            return NULL;
        }

        return &front->data;
    }

    Song dequeue() {
        if (front == NULL) {
            return Song();
        }

        QueueNode* temp = front;
        Song result = temp->data;

        front = front->next;

        if (front == NULL) {
            rear = NULL;
        }

        delete temp;
        count--;

        return result;
    }

    void display() const {
        cout << "\n";
        cout << "=====================================================\n";
        cout << "                 UPCOMING QUEUE\n";
        cout << "=====================================================\n";

        if (front == NULL) {
            cout << "Queue is empty.\n";
        }
        else {
            QueueNode* temp = front;
            int number = 1;

            while (temp != NULL) {
                cout << number << ". ";
                temp->data.display();

                temp = temp->next;
                number++;
            }
        }

        cout << "=====================================================\n";
    }

    void clear() {
        while (front != NULL) {
            dequeue();
        }
    }
};

// ============================================================
// STACK - LIFO
// Implemented using a singly linked stack
// ============================================================
class StackNode {
public:
    Song data;
    StackNode* next;

    StackNode(const Song& song) {
        data = song;
        next = NULL;
    }
};

class RecentlyPlayedStack {
private:
    StackNode* top;

public:
    int count;

    RecentlyPlayedStack() {
        top = NULL;
        count = 0;
    }

    ~RecentlyPlayedStack() {
        clear();
    }

    void push(const Song& song) {
        StackNode* newNode = new StackNode(song);

        newNode->next = top;
        top = newNode;

        count++;
    }

    bool isEmpty() const {
        return top == NULL;
    }

    Song pop() {
        if (top == NULL) {
            return Song();
        }

        StackNode* temp = top;
        Song result = temp->data;

        top = top->next;

        delete temp;
        count--;

        return result;
    }

    void display() const {
        cout << "\n";
        cout << "=====================================================\n";
        cout << "                RECENTLY PLAYED\n";
        cout << "=====================================================\n";

        if (top == NULL) {
            cout << "No songs played yet.\n";
        }
        else {
            StackNode* temp = top;
            int number = 1;

            while (temp != NULL) {
                cout << number << ". ";
                temp->data.display();

                temp = temp->next;
                number++;
            }
        }

        cout << "=====================================================\n";
    }

    void clear() {
        while (top != NULL) {
            pop();
        }
    }
};

// ============================================================
// MUSIC PLAYER - WINDOWS MCI
// ============================================================
class MusicPlayer {
private:
    bool opened;
    bool playing;

public:
    MusicPlayer() {
        opened = false;
        playing = false;
    }

    ~MusicPlayer() {
        stop();
    }

    bool play(const string& path) {
        stop();

        string command = "open \"" + path +
                         "\" type mpegvideo alias music";

        DWORD result = mciSendStringA(
            command.c_str(), NULL, 0, NULL
        );

        if (result != 0) {
            return false;
        }

        result = mciSendStringA(
            "play music", NULL, 0, NULL
        );

        if (result != 0) {
            mciSendStringA("close music", NULL, 0, NULL);
            return false;
        }

        opened = true;
        playing = true;

        return true;
    }

    void pause() {
        if (opened) {
            mciSendStringA("pause music", NULL, 0, NULL);
            playing = false;
        }
    }

    void resume() {
        if (opened) {
            mciSendStringA("resume music", NULL, 0, NULL);
            playing = true;
        }
    }

    void stop() {
        if (opened) {
            mciSendStringA("stop music", NULL, 0, NULL);
            mciSendStringA("close music", NULL, 0, NULL);
        }

        opened = false;
        playing = false;
    }
};

// ============================================================
// MUSIC PLAYLIST MANAGER
// ============================================================
class MusicPlaylistManager {
private:
    Playlist playlist;
    SongQueue queue;
    RecentlyPlayedStack history;
    MusicPlayer player;

    string databaseFile;

    // --------------------------------------------------------
    // INPUT HELPERS
    // --------------------------------------------------------
    void clearInput() {
        cin.clear();
        cin.ignore(numeric_limits<streamsize>::max(), '\n');
    }

    string getInput(const string& message) {
        string value;

        cout << message;
        getline(cin, value);

        return value;
    }

    int getMenuChoice() {
        int choice;

        cout << "Enter your choice: ";

        while (!(cin >> choice)) {
            cout << "Please enter a number: ";
            clearInput();
        }

        clearInput();

        return choice;
    }

    int getNumber(const string& message) {
        int number;

        cout << message;

        while (!(cin >> number)) {
            cout << "Please enter a valid number: ";
            clearInput();
        }

        clearInput();

        return number;
    }

    // --------------------------------------------------------
    // FILE STORAGE
    // --------------------------------------------------------
    void savePlaylist() {
        ofstream file(databaseFile);

        if (!file.is_open()) {
            cout << "\nWarning: Could not save playlist.\n";
            return;
        }

        Node* temp = playlist.getHead();

        while (temp != NULL) {

            // We disallow | in user input, so this remains safe.
            file << temp->data.title << "|"
                 << temp->data.artist << "|"
                 << temp->data.filePath << "\n";

            temp = temp->next;
        }

        file.close();
    }

    void loadPlaylist() {
        ifstream file(databaseFile);

        if (!file.is_open()) {
            // First run: nothing to load.
            return;
        }

        string line;

        while (getline(file, line)) {

            if (line.empty()) {
                continue;
            }

            string title;
            string artist;
            string path;

            size_t firstSeparator = line.find('|');
            size_t secondSeparator = line.find('|', firstSeparator + 1);

            if (firstSeparator == string::npos ||
                secondSeparator == string::npos) {
                continue;
            }

            title = line.substr(0, firstSeparator);

            artist = line.substr(
                firstSeparator + 1,
                secondSeparator - firstSeparator - 1
            );

            path = line.substr(secondSeparator + 1);

            if (!title.empty() && !path.empty()) {
                playlist.addSong(
                    Song(title, artist, path)
                );
            }
        }

        file.close();
    }

    // --------------------------------------------------------
    // MENU / UI
    // --------------------------------------------------------
    void showHeader() const {
        system("cls");

        cout << "\n";
        cout << "============================================================\n";
        cout << "              MUSIC PLAYLIST MANAGER\n";
        cout << "============================================================\n";
        cout << "       DSA Project: Linked List | Queue | Stack\n";
        cout << "============================================================\n";
    }

    void showMenu() const {
        cout << "\n";
        cout << "--------------- MAIN MENU ----------------\n";
        cout << "1.  Add Song\n";
        cout << "2.  Delete Song\n";
        cout << "3.  Display Playlist\n";
        cout << "4.  Search Song\n";
        cout << "5.  Play Song\n";
        cout << "6.  Next Song\n";
        cout << "7.  Previous Song\n";
        cout << "8.  Pause Song\n";
        cout << "9.  Resume Song\n";
        cout << "10. Stop Song\n";
        cout << "11. Add Song to Queue\n";
        cout << "12. Show Queue\n";
        cout << "13. Show Recently Played\n";
        cout << "14. Sort Playlist A-Z\n";
        cout << "15. Save Playlist Now\n";
        cout << "16. Clear Playlist\n";
        cout << "17. Exit\n";
        cout << "-------------------------------------------\n";
    }

    void waitForEnter() {
        cout << "\nPress Enter to continue...";
        cin.get();
    }

    // --------------------------------------------------------
    // SONG OPERATIONS
    // --------------------------------------------------------
    void addSong() {
        cout << "\n========== ADD SONG ==========\n";

        string title = getInput("Enter song title: ");
        string artist = getInput("Enter artist name: ");
        string path = getInput("Enter full audio file path: ");

        if (title.empty() || artist.empty() || path.empty()) {
            cout << "\nAll fields are required.\n";
            return;
        }

        // "|" is our storage separator.
        if (title.find('|') != string::npos ||
            artist.find('|') != string::npos ||
            path.find('|') != string::npos) {

            cout << "\nPlease do not use the | character.\n";
            return;
        }

        if (!fileExists(path)) {
            cout << "\nWarning: audio file was not found at this path.\n";
            cout << "The song will still be saved, but playback will fail\n";
            cout << "until the path points to a real file.\n";
        }

        playlist.addSong(
            Song(title, artist, path)
        );

        savePlaylist();

        cout << "\nSong added and playlist saved successfully!\n";
    }

    void deleteSong() {
        if (playlist.count == 0) {
            cout << "\nPlaylist is empty.\n";
            return;
        }

        string title = getInput(
            "\nEnter exact song title to delete: "
        );

        if (playlist.deleteSong(title)) {
            savePlaylist();

            cout << "\nSong deleted successfully!\n";
        }
        else {
            cout << "\nSong not found.\n";
        }
    }

    void searchSong() {
        if (playlist.count == 0) {
            cout << "\nPlaylist is empty.\n";
            return;
        }

        string keyword = getInput(
            "\nEnter song title or artist to search: "
        );

        Node* result = playlist.searchSong(keyword);

        if (result == NULL) {
            cout << "\nSong not found.\n";
            return;
        }

        cout << "\nSong Found!\n";
        cout << "-------------------------------------------\n";
        cout << "Title  : " << result->data.title << endl;
        cout << "Artist : " << result->data.artist << endl;
        cout << "File   : " << result->data.filePath << endl;
        cout << "-------------------------------------------\n";
    }

    // --------------------------------------------------------
    // PLAYBACK
    // --------------------------------------------------------
    void playNode(Node* node) {
        if (node == NULL) {
            cout << "\nNo song selected.\n";
            return;
        }

        if (!fileExists(node->data.filePath)) {
            cout << "\nAudio file not found:\n";
            cout << node->data.filePath << endl;
            return;
        }

        if (player.play(node->data.filePath)) {
            playlist.current = node;

            history.push(node->data);

            cout << "\nNow Playing: ";
            node->data.display();
        }
        else {
            cout << "\nCould not play the audio file.\n";
            cout << "Try an MP3 file and check the full path.\n";
        }
    }

    void playSong() {
        if (playlist.count == 0) {
            cout << "\nPlaylist is empty.\n";
            return;
        }

        playlist.display();

        int number = getNumber(
            "\nEnter song number to play: "
        );

        Node* node = playlist.getNodeByNumber(number);

        if (node == NULL) {
            cout << "\nInvalid song number.\n";
            return;
        }

        playNode(node);
    }

    void nextSong() {
        if (playlist.count == 0 ||
            playlist.current == NULL) {

            cout << "\nPlaylist is empty.\n";
            return;
        }

        // Queue has priority.
        if (!queue.isEmpty()) {
            Song queuedSong = queue.dequeue();

            Node* node = playlist.searchSong(
                queuedSong.title
            );

            if (node != NULL) {
                playNode(node);
                return;
            }
        }

        if (playlist.current->next != NULL) {
            playNode(playlist.current->next);
        }
        else {
            cout << "\nAlready at the last song.\n";
        }
    }

    void previousSong() {
        if (playlist.count == 0 ||
            playlist.current == NULL) {

            cout << "\nPlaylist is empty.\n";
            return;
        }

        if (playlist.current->prev != NULL) {
            playNode(playlist.current->prev);
        }
        else {
            cout << "\nAlready at the first song.\n";
        }
    }

    // --------------------------------------------------------
    // QUEUE
    // --------------------------------------------------------
    void addToQueue() {
        if (playlist.count == 0) {
            cout << "\nPlaylist is empty.\n";
            return;
        }

        playlist.display();

        int number = getNumber(
            "\nEnter song number to add to queue: "
        );

        Node* node = playlist.getNodeByNumber(number);

        if (node == NULL) {
            cout << "\nInvalid song number.\n";
            return;
        }

        queue.enqueue(node->data);

        cout << "\nAdded to queue: ";
        node->data.display();
    }

    // --------------------------------------------------------
    // SORT / CLEAR / SAVE
    // --------------------------------------------------------
    void sortPlaylist() {
        if (playlist.count < 2) {
            cout << "\nNot enough songs to sort.\n";
            return;
        }

        playlist.sortByTitle();
        savePlaylist();

        cout << "\nPlaylist sorted using Bubble Sort (A-Z).\n";
        cout << "Updated playlist has been saved.\n";
    }

    void clearPlaylist() {
        if (playlist.count == 0) {
            cout << "\nPlaylist is already empty.\n";
            return;
        }

        string confirmation = getInput(
            "\nType YES to clear the entire playlist: "
        );

        if (confirmation == "YES") {
            player.stop();
            playlist.clear();
            savePlaylist();

            cout << "\nPlaylist cleared and saved.\n";
        }
        else {
            cout << "\nClear operation cancelled.\n";
        }
    }

public:
    MusicPlaylistManager() {
        databaseFile = getSaveFilePath();
        loadPlaylist();
    }

    void run() {

        int choice;

        do {
            showHeader();

            cout << "Saved playlist file:\n";
            cout << databaseFile << "\n";

            if (playlist.count > 0) {
                cout << "Songs loaded: " << playlist.count << "\n";
            }
            else {
                cout << "Songs loaded: 0\n";
            }

            showMenu();

            choice = getMenuChoice();

            cout << "\n";

            switch (choice) {

            case 1:
                addSong();
                break;

            case 2:
                deleteSong();
                break;

            case 3:
                playlist.display();
                break;

            case 4:
                searchSong();
                break;

            case 5:
                playSong();
                break;

            case 6:
                nextSong();
                break;

            case 7:
                previousSong();
                break;

            case 8:
                player.pause();
                cout << "Song paused.\n";
                break;

            case 9:
                player.resume();
                cout << "Song resumed.\n";
                break;

            case 10:
                player.stop();
                cout << "Song stopped.\n";
                break;

            case 11:
                addToQueue();
                break;

            case 12:
                queue.display();
                break;

            case 13:
                history.display();
                break;

            case 14:
                sortPlaylist();
                break;

            case 15:
                savePlaylist();
                cout << "Playlist saved successfully!\n";
                break;

            case 16:
                clearPlaylist();
                break;

            case 17:
                savePlaylist();
                player.stop();

                cout << "Playlist saved.\n";
                cout << "Thank you for using Music Playlist Manager!\n";
                break;

            default:
                cout << "Invalid choice. Try again.\n";
            }

            if (choice != 17) {
                waitForEnter();
            }

        } while (choice != 17);
    }
};

// ============================================================
// MAIN
// ============================================================
int main() {
    MusicPlaylistManager app;

    app.run();

    return 0;
}
